# ── API-first GTM chain ──────────────────────────────────────────────
# Every key is optional. Each skill uses only the keys it needs and
# degrades gracefully when one is missing - it logs the skipped layer
# and continues. The router (00), the qualify gate (01-icp-qualify),
# and the judgment layer (05) need no keys at all.

# Prospeo - company discovery + lookalikes (01) and email resolution (06)
# https://prospeo.io
PROSPEO_API_KEY=

# Apify - Google Maps SMB discovery (02) and prospect-posts
# https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Firecrawl - website scraping and extraction (03)
# https://firecrawl.dev
FIRECRAWL_API_KEY=

# CrustData - funding / headcount / recent-hire signals (04)
# https://crustdata.com
CRUSTDATA_API_KEY=

# TheirStack - open job postings as hiring signals (04)
# https://app.theirstack.com/settings/api
THEIRSTACK_API_KEY=

# Email resolution waterfall (06) - set any subset; rungs without a key
# are skipped. Cost order: AI Ark -> Prospeo -> Blitz -> Findymail,
# validated by ZeroBounce.
AIARK_API_KEY=
BLITZ_API_KEY=
FINDYMAIL_API_KEY=
ZEROBOUNCE_API_KEY=

# Optional: external judge for large icp-qualify runs (01). Leave unset
# and qualification runs in-session with no per-company cost.
QUALIFY_LLM_BASE_URL=
QUALIFY_LLM_API_KEY=
QUALIFY_LLM_MODEL=
